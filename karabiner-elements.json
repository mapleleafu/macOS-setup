[
    {
        "description": "Option+arrows: fill / left / right (not Mission Control)",
        "manipulators": [
            {
                "type": "basic",
                "from": {
                    "key_code": "up_arrow",
                    "modifiers": {
                        "mandatory": [
                            "option"
                        ]
                    }
                },
                "to": [
                    {
                        "shell_command": "$HOME/.config/karabiner/scripts/tile.sh fill"
                    }
                ]
            },
            {
                "type": "basic",
                "from": {
                    "key_code": "left_arrow",
                    "modifiers": {
                        "mandatory": [
                            "option"
                        ]
                    }
                },
                "to": [
                    {
                        "shell_command": "$HOME/.config/karabiner/scripts/tile.sh left"
                    }
                ]
            },
            {
                "type": "basic",
                "from": {
                    "key_code": "right_arrow",
                    "modifiers": {
                        "mandatory": [
                            "option"
                        ]
                    }
                },
                "to": [
                    {
                        "shell_command": "$HOME/.config/karabiner/scripts/tile.sh right"
                    }
                ]
            }
        ]
    },
